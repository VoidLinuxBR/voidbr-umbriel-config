            ("Mod + P", "Fixar ou desafixar a janela"),
            ("Mod + Q", "Fechar a janela"),
            ("Mod + T", "Alternar janela flutuante"),
            ("Mod + Shift + T", "Alternar todas as janelas para flutuante"),
        ]),
        ("Área temporária", [
            ("Mod + Ctrl + Space", "Restaurar janela da área temporária"),
            ("Mod + Shift + Space", "Mover janela para a área temporária"),
            ("Mod + Space", "Mostrar ou ocultar a área temporária"),
            ("Mod + Tab", "Focar a próxima janela da área temporária"),
        ]),
        ("Áreas de trabalho", [
            ("Mod + 1…9", "Alternar para a área de trabalho de 1 a 9"),
            ("Mod + Shift + 1…9", "Mover janela para a área de trabalho de 1 a 9"),
        ]),
        ("Visão geral", [
            ("Mod + O", "Mostrar ou ocultar a visão geral"),
