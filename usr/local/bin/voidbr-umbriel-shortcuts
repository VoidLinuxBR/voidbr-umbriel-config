        ("Sistema", [
            ("Mod + Escape", "Encerrar a sessão"),
            ("Mod + Shift + Escape", "Ativar ou desativar a inibição de atalhos"),
            ("Mod + ? ou /", "Mostrar ou ocultar este guia de atalhos"),
        ]),
    ]
else:
    UI_TITLE = "Umbriel Shortcuts"
    UI_FOOTER = "Mod = Super · press any key to close"
    SHORTCUTS = [
        ("Applications", [
            ("Mod", "Open Noctalia app launcher"),
            ("Mod + Return", "Open foot terminal"),
            ("Print", "Take a screenshot"),
            ("Shift + Print", "Take a full screen screenshot"),
        ]),
        ("Focus", [
            ("Mod + J", "Move focus down"),
