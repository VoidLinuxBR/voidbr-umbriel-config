# Cores padrão; o tema do Noctalia (~/.config/umbriel/noctalia.toml) tem prioridade
DEFAULT_COLORS = {
    "background": "#211f22",
    "text": "#ded7e2",
    "border": "#b9a9bf",
    "title": "#d8c9dc",
    "section": "#cfc4d2",
    "key_fg": "#e0d3e8",
    "key_bg": "#39343c",
    "desc": "#e0d9e1",
    "footer": "#cfc4d2",
}


def _hex(value):
    """'#RRGGBBAA' -> '#RRGGBB' (o GTK CSS aceita alfa, mas o guia usa fundo opaco)."""
    if isinstance(value, str) and value.startswith("#") and len(value) in (7, 9):
        return value[:7]
    return None


def load_colors():
    colors = dict(DEFAULT_COLORS)
    path = os.path.expanduser("~/.config/umbriel/noctalia.toml")
    try:
        with open(path, "rb") as f:
            theme = tomllib.load(f).get("colors", {})
    except (OSError, tomllib.TOMLDecodeError):
        return colors
    mapping = {
        "background": theme.get("background"),
        "text": theme.get("text_primary"),
        "desc": theme.get("text_primary"),
        "key_fg": theme.get("text_primary"),
        "border": theme.get("accent_primary"),
        "title": theme.get("accent_primary"),
        "section": theme.get("text_muted"),
        "footer": theme.get("text_muted"),
        "key_bg": theme.get("backdrop"),
    }
    for name, value in mapping.items():
        value = _hex(value)
        if value:
            colors[name] = value
    return colors


def make_css():
    c = load_colors()
    return f"""
window {{ background: {c["background"]}; color: {c["text"]}; }}
.cheatsheet {{ background: {c["background"]}; border: 1px solid {c["border"]}; border-radius: 10px; padding: 22px 24px 18px 24px; }}
.title {{ font-family: monospace; font-size: 16px; font-weight: bold; color: {c["title"]}; margin-bottom: 10px; }}
.section {{ font-family: monospace; font-size: 12px; font-weight: bold; color: {c["section"]}; margin-top: 5px; margin-bottom: 1px; }}
.key {{ font-family: monospace; font-size: 11px; color: {c["key_fg"]}; background: {c["key_bg"]}; padding: 1px 5px; }}
.desc {{ font-family: monospace; font-size: 11px; color: {c["desc"]}; }}
.footer {{ font-family: monospace; font-size: 11px; color: {c["footer"]}; margin-top: 10px; }}
""".encode()

class Win(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=_("Atalhos do Umbriel"))
        self.set_default_size(860, 640)
        self.set_resizable(False)

        provider = Gtk.CssProvider()
        provider.load_from_data(make_css())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.add_css_class("cheatsheet")

        title = Gtk.Label(label=_("Atalhos do Umbriel"), xalign=0)
        title.add_css_class("title")
        root.append(title)

        grid = Gtk.Grid()
        grid.set_column_spacing(28)
        grid.set_column_homogeneous(True)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)

        for title_text, rows in SHORTCUTS[:4]:
            left.append(self.make_section(title_text, rows))
        for title_text, rows in SHORTCUTS[4:]:
            right.append(self.make_section(title_text, rows))

        grid.attach(left, 0, 0, 1, 1)
        grid.attach(right, 1, 0, 1, 1)
        root.append(grid)

        footer = Gtk.Label(
            label=_("Mod = Super · pressione qualquer tecla para fechar"),
            xalign=0
        )
        footer.add_css_class("footer")
        root.append(footer)
        self.set_child(root)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key_pressed)
        self.add_controller(keys)

        click = Gtk.GestureClick()
        click.connect("released", lambda *_: self.close())
        self.add_controller(click)

    @staticmethod
    def make_section(title, rows):
        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        heading = Gtk.Label(label=title, xalign=0)
        heading.add_css_class("section")
        section.append(heading)

        for key, description in rows:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            key_label = Gtk.Label(label=key, xalign=0)
            key_label.add_css_class("key")
            key_label.set_width_chars(max(8, len(key)))
            desc_label = Gtk.Label(label=description, xalign=0)
            desc_label.add_css_class("desc")
            desc_label.set_hexpand(True)
            row.append(key_label)
            row.append(desc_label)
            section.append(row)
        return section

    def on_key_pressed(self, controller, keyval, keycode, state):
        self.close()
        return True


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.voidbr.umbriel-cheatsheet")

    def do_activate(self):
        Win(self).present()


if __name__ == "__main__":
    App().run()
