#!/usr/bin/env python3
import locale
import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gdk

def get_language():
    try:
        loc, _ = locale.getdefaultlocale()
        if loc and loc.startswith('pt'):
            return 'pt'
    except:
        pass
    return 'en'

lang = get_language()

if lang == 'pt':
    UI_TITLE = "Atalhos do Umbriel"
    UI_FOOTER = "Mod = Super · pressione qualquer tecla para fechar"
    SHORTCUTS = [
        ("Aplicativos", [
            ("Mod", "Abrir o lançador de aplicativos do Noctalia"),
            ("Mod + Return", "Abrir o terminal foot"),
            ("Print", "Capturar a tela"),
            ("Shift + Print", "Capturar a tela inteira"),
        ]),
        ("Foco", [
            ("Mod + J", "Mover o foco para baixo"),
            ("Mod + F1", "Focar a próxima janela"),
            ("Mod + H", "Mover o foco para a esquerda"),
            ("Mod + K", "Mover o foco para cima"),
            ("Mod + L", "Mover o foco para a direita"),
            ("Mod + Wheel", "Alternar o foco entre janelas flutuantes"),
        ]),
        ("Mover e redimensionar", [
            ("Mod + ,", "Mover a janela para a coluna à esquerda"),
            ("Mod + .", "Mover a janela para a coluna à direita"),
            ("Mod + R", "Alternar a extensão principal da coluna"),
            ("Mod + Shift + ↓", "Mover a janela para baixo"),
            ("Mod + Shift + ←", "Mover a coluna para a esquerda"),
