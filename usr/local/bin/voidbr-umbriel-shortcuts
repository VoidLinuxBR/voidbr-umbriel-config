        ]),
        ("Windows", [
            ("Mod + Ctrl + F", "Toggle window maximization"),
            ("Mod + F", "Toggle fullscreen"),
            ("Mod + M", "Maximize window to borders"),
            ("Mod + P", "Pin or unpin window"),
            ("Mod + Q", "Close window"),
            ("Mod + T", "Toggle floating window"),
            ("Mod + Shift + T", "Toggle all windows floating"),
        ]),
        ("Scratchpad", [
            ("Mod + Ctrl + Space", "Restore scratchpad window"),
